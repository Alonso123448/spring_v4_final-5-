spring.application.name=spring_v4

spring.datasource.url=jdbc:sqlserver://localhost:1433;databaseName=Sistema_Marcos;encrypt=false
spring.datasource.username=sa
spring.datasource.password=TU_PASSWORD_AQUI

spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true

# DevTools - hot reload
spring.thymeleaf.cache=false
spring.web.resources.cache.period=0

# Limite de subida de archivos (10MB por archivo, 20MB por request)
spring.servlet.multipart.max-file-size=10MB
spring.servlet.multipart.max-request-size=20MB

# API Token consulta DNI/RUC (obtener en miapi.cloud)
miapi.token=TU_TOKEN_AQUI

# Datos del negocio (notas de venta / impresion)
app.nombre=Inventario
app.rubro=Sistema de Gestion

# Gmail SMTP (usar una "contraseña de aplicacion" de Gmail, no tu password normal)
spring.mail.host=smtp.gmail.com
spring.mail.port=587
spring.mail.username=tu-correo@gmail.com
spring.mail.password=TU_APP_PASSWORD_AQUI
spring.mail.properties.mail.smtp.auth=true
spring.mail.properties.mail.smtp.starttls.enable=true
spring.mail.properties.mail.smtp.starttls.required=true

# Datos de pago (catalogo online)
app.yape.numero=999999999
app.yape.nombre=Nombre de tu tienda
app.yape.qr=/imagenes/YapeQR/yape-qr.png.jpeg
app.transferencia.banco=BCP
app.transferencia.cuenta=000-00000000-0-00
app.transferencia.cci=00000000000000000000
